<UserControl x:Class="QRcodeStorage.Views.UserControls.ucFileInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QRcodeStorage.Views.UserControls"
             mc:Ignorable="d" 
             Height="auto">
    <Border x:Name="brBack" Background="#1f2c38" CornerRadius="5" BorderBrush="#CCBC41" BorderThickness="5,0,0,0">
        <Grid Margin="20,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition MaxHeight="150"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Viewbox Height="30" >
                    <Path x:Name="icon" 
                          Data="{StaticResource icon_GenerateQR}"
                          Stretch="UniformToFill"
                          Fill="#CCBC41"
                          Width="20" Height="20">
                    </Path>
                </Viewbox>
                <TextBlock Text="QR-КОД" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="#9aaebf" Margin="20,0,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#282916" CornerRadius="5" x:Name="brPath"
                    BorderBrush="#CCBC41" BorderThickness="1">
                <TextBlock x:Name="tbPath" Text="Куда заднюю даёшь" 
                           FontSize="14" Foreground="White" Margin="10" TextWrapping="WrapWithOverflow"/>
            </Border>

            <TextBlock x:Name="tbOperationType" Grid.Row="2"
                           Text="Операция отменена" FontSize="20" 
                           FontWeight="Bold" VerticalAlignment="Center" 
                           Foreground="#9aaebf"/>

            <Grid Grid.Row="3"  Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="tbQrInfo" Text="-" FontSize="20" 
                           FontWeight="Thin" VerticalAlignment="Center" 
                           Foreground="#9aaebf" 
                           TextWrapping="WrapWithOverflow"/>

                <TextBlock x:Name="tbFileSize" Text="0,00 Б" FontSize="14" FontWeight="Regular" 
                           VerticalAlignment="Center" Grid.Column="1" HorizontalAlignment="Right"
                           Foreground="#9aaebf"/>
            </Grid>

        </Grid>
    </Border>
</UserControl>
