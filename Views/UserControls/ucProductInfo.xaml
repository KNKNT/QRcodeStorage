<UserControl x:Class="QRcodeStorage.Views.UserControls.ucProductInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QRcodeStorage.Views.UserControls"
             mc:Ignorable="d" 
             MaxHeight="700">
    <Border Background="White">
        <Grid Margin="30,0,30,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition />
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Accent}" Height="30"  CornerRadius="5" Margin="0,10,0,10" Padding="20,0,20,0" HorizontalAlignment="Left">
                <TextBlock FontSize="14" Foreground="White" FontWeight="Medium" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Run Text="ID:"/>
                    <Run x:Name="tbId" Text="123"/>
                </TextBlock>
            </Border>

            <TextBlock Name="tbProductName" Grid.Row="1" Grid.ColumnSpan="2" Text="Перфоратор" Foreground="{StaticResource Accent}" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" Margin="0,10,0,5"/>

            <Border Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="1" Background="Black" Margin="0,0,0,0"/>

            <TextBlock Grid.Row="2" FontSize="16"
                       Text="Производитель" Margin="0,30,0,10" 
                       VerticalAlignment="Center" />

            <TextBlock Name="tbMaker" Grid.Row="2" Grid.Column="1" FontSize="16"
                       Text="Bosh" Margin="0,30,0,10" FontWeight="Medium"
                       VerticalAlignment="Center" HorizontalAlignment="Left" />
            <Border Grid.Row="2" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="LightGray"/>
            
            <TextBlock Grid.Row="3" FontSize="16"
                       Text="Категория" Margin="0,10,0,10" 
                       VerticalAlignment="Center" />

            <TextBlock Name="tbCategory" Grid.Row="3" Grid.Column="1" FontSize="16"
                       Text="Электротовар" Margin="0,10,0,10" FontWeight="Medium"
                       VerticalAlignment="Center" HorizontalAlignment="Left" />
            <Border Grid.Row="3" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="LightGray"/>


            <TextBlock Grid.Row="4" FontSize="16"
                       Text="Место хранения" Margin="0,10,0,10" 
                       VerticalAlignment="Center" />

            <TextBlock Name="tbPlace" Grid.Row="4" Grid.Column="1" FontSize="16"
                       Text="Стелаж Ф-12" Margin="0,5,0,5" FontWeight="Medium"
                       VerticalAlignment="Center" HorizontalAlignment="Left" />

            <TextBlock Grid.Row="5" FontSize="16"
                       Text="Количество" Margin="0,10,0,10" 
                       VerticalAlignment="Center" />

            <TextBlock Name="tbCount" Grid.Row="5" Grid.Column="1" FontSize="16"
                       Text="12" Margin="0,5,0,5" FontWeight="Medium"
                       VerticalAlignment="Center" HorizontalAlignment="Left" />
            <Border Grid.Row="4" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="LightGray"/>

            <Border Grid.Row="5" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="LightGray"/>

            <Border Grid.Row="6" Grid.ColumnSpan="2" Background="#f6f7fb" Margin="0,10,0,10" CornerRadius="5" BorderThickness="5,0,0,0" BorderBrush="{StaticResource Accent}">
                <StackPanel>
                    <TextBlock FontSize="16" Foreground="#496684"
                            Text="Описание" Margin="10,10,0,10" 
                            VerticalAlignment="Center" />
                    <TextBlock Name="tbDescription" FontSize="16" 
                                Text="Бла бла бла блю блю блю ыввввввввввмыцайкуйпку пууммумук" Margin="10,0,0,10" TextWrapping="WrapWithOverflow" 
                                VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Row="6" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="LightGray"/>

            <Grid Grid.Row="8" Grid.ColumnSpan="2" Margin="0,20,0,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Background="Transparent" BorderBrush="Gray" Height="40" BorderThickness="1" CornerRadius="5" VerticalAlignment="Top" ClipToBounds="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="tblCount" Text="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Border Width="1" Margin="0,7,0,7" Background="LightGray" HorizontalAlignment="Right"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="btnPlus" Height="20" Width="30" Click="btnPlus_Click" >
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}">
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="Transparent" CornerRadius="0,5,0,0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border"  Property="Background" Value="#E3E3E3"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Foreground" Value="Gray"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="Gray"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="▴" FontSize="20" VerticalAlignment="Center" Margin="0,5,0,0"/>
                            </Button>
                            <Button x:Name="btnMinus" Height="20" Width="30" Click="btnMinus_Click" >
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}">
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="Transparent" CornerRadius="0,0,5,0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border"  Property="Background" Value="#E3E3E3"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Foreground" Value="Gray"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="Gray"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="▾" FontSize="20" VerticalAlignment="Center" Margin="0,0,0,5"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Button Grid.Column="1" Style="{StaticResource UpdateButton}" Margin="14,0,0,0" Click="Button_Click" >
                    <TextBlock Text="Списать" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
