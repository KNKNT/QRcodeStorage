<Window x:Class="QRcodeStorage.Views.Notification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QRcodeStorage.Views"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Title="Notification" Height="120" Width="400" MouseDown="Window_MouseDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Border  Background="White" Margin="10" CornerRadius="10" BorderThickness="1" BorderBrush="#e3e9f1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" Opacity="0.3" Color="Black" BlurRadius="10"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Background}" CornerRadius="100" Margin="20">
                <Viewbox Margin="15" >
                    <Path x:Name="icon" 
                      Data="{StaticResource icon_GenerateQR}"
                      Stretch="UniformToFill"
                      Fill="{StaticResource Accept}"
                      Width="20" Height="20">
                    </Path>
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="tbHeader" Text="QR не распознан" FontSize="14" FontWeight="Medium" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="tbCaption" Text="Товара с кодом 'УСТУЦЩСМТЦЩМ' не существует" Foreground="{StaticResource Accent}" TextWrapping="WrapWithOverflow"/>
            </StackPanel>

            <Button Margin="15" Width="40" Height="40" Grid.Column="2" Style="{StaticResource CloseButton}" Click="Button_Click">
                <TextBlock Text="×" FontSize="28" VerticalAlignment="Center" TextAlignment="Center"/>
            </Button>
        </Grid>
    </Border>
    
</Window>
