<Page x:Class="QRcodeStorage.Views.Registration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QRcodeStorage.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Registration">

    <Grid>
        <Border Height="400" Width="600" Margin="0,50,0,50" Background="White" CornerRadius="15" Padding="40">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Вход" Foreground="#2c3e50" FontSize="30" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <TextBlock Text="Логин" FontSize="14" FontWeight="Medium" Margin="0,0,0,5"/>
                <TextBox x:Name="tbLogin" FontSize="14" Height="40" VerticalContentAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="Пароль" FontSize="14" FontWeight="Medium" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="tbPassword" FontSize="14" Height="40" VerticalContentAlignment="Center" Visibility="Collapsed"/>
                    <PasswordBox x:Name="psPassword" FontSize="14" Height="40" VerticalContentAlignment="Center"  />
                    <Button x:Name="btShowPassword" Content="🔓" FontWeight="Black" FontSize="20" Width="40" Height="40" Grid.Column="1" Background="White" Click="btShowPassword_Click"/>
                </Grid>

                <Button x:Name="btLogin" Content="Войти" FontSize="20" Height="40" Width="200" Style="{StaticResource UpdateButton}" Click="btLogin_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
