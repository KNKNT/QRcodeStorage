<Page x:Class="QRcodeStorage.Views.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QRcodeStorage.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegistrationPage">

    <Grid>
        <Border Background="White" CornerRadius="15" MaxWidth="500" Padding="30" Margin="100">
            <StackPanel>
                <TextBlock Text="Вход" Foreground="{StaticResource Foreground}" FontSize="30" FontWeight="Bold" Margin="0,0,0,15" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <TextBlock Text="Логин" FontSize="14" FontWeight="Medium" Margin="0,0,0,5"/>
                <TextBox FontSize="14" Height="40" VerticalContentAlignment="Center" Margin="0,0,0,15"/>
                <TextBlock Text="Пароль" FontSize="14" FontWeight="Medium" Margin="0,0,0,5"/>
                <TextBox FontSize="14" Height="40" VerticalContentAlignment="Center" Margin="0,0,0,15"/>
            </StackPanel>

        </Border>
    </Grid>
</Page>
