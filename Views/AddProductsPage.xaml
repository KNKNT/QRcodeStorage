<Page x:Class="QRcodeStorage.Views.AddProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QRcodeStorage.Views"
      xmlns:srv="clr-namespace:QRcodeStorage.Services"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="1000"
      Title="AddProductsPage">
    <Page.Resources>
        <srv:NullConverter x:Key="NullConverter" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,15" Background="White" CornerRadius="15">
            <Grid Margin="15,15,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="Фильтры поиска:" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,14,15">
                        <TextBlock Text="Название" FontSize="14" FontWeight="Medium" Margin="0,0,0,5"/>
                        <TextBox x:Name="tbSearchName" FontSize="14" Height="40" VerticalContentAlignment="Center" TextChanged="tbSearchName_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,7,0">
                        <TextBlock Text="Категория" FontSize="14" FontWeight="Medium" Margin="0,0,0,5" />
                        <ComboBox  x:Name="cbCategory" FontSize="14" Height="40" SelectedIndex="0" VerticalContentAlignment="Center" DropDownClosed="cbCategory_DropDownClosed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="7,0,0,0">
                        <TextBlock Text="Производитель " FontSize="14" FontWeight="Medium" Margin="0,0,0,5"/>
                        <ComboBox Name="cbMakers" FontSize="14" Height="40" VerticalContentAlignment="Center" Margin="0,0,0,15" DropDownClosed="cbMakers_DropDownClosed"/>
                    </StackPanel>

                    <Button 
                        x:Name="btnResetFilters"
                        Content="Сброс" 
                        Style="{StaticResource CancelButton}" 
                        Grid.Column="3" 
                        Height="40" 
                        Width="150"
                        Margin="14,0,0,15" 
                        VerticalAlignment="Bottom"/>
                </Grid>


            </Grid>
        </Border>

        <DataGrid x:Name="dgProducts" Style="{StaticResource MaterialDesignDataGrid}" IsReadOnly="True" SelectionMode="Single" Grid.Row="1" AutoGenerateColumns="False" SelectionChanged="dgProducts_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id_product}" Width="40"/>
                <DataGridTextColumn Header="Название" Binding="{Binding name, Converter={StaticResource NullConverter}}" Width="0.3*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding category, Converter={StaticResource NullConverter}}" Width="0.3*"/>
                <DataGridTextColumn Header="Производитель" Binding="{Binding maker, Converter={StaticResource NullConverter}}" Width="0.3*" />
                <DataGridTextColumn Header="Место хранения" Binding="{Binding place, Converter={StaticResource NullConverter}}"  Width="0.4*" />
                <DataGridTextColumn Header="Описание" Binding="{Binding description, Converter={StaticResource NullConverter}}" Width="0.5*" />
                <DataGridTextColumn FontWeight="Bold" Header="Кол-во" Binding="{Binding count, Converter={StaticResource NullConverter}}" Width="0.2*"/>
            </DataGrid.Columns>
        </DataGrid>


        <StackPanel 
            Margin="0,15,0,15"
            Grid.Row="2"
            Orientation="Horizontal" 
            HorizontalAlignment="Right">
            <Border x:Name="Counter" Margin="0,0,15,0" IsEnabled="False" Background="White" BorderBrush="Gray" Grid.Row="2" Height="45" BorderThickness="1" CornerRadius="5" VerticalAlignment="Center" ClipToBounds="True" HorizontalAlignment="Left" Width="197">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="tblCount" Text="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="Transparent" BorderThickness="0" TextChanged="tblCount_TextChanged"/>
                    <Border Width="1" Margin="0,7,0,7" Background="LightGray" HorizontalAlignment="Right"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="btnPlus" Height="20" Width="30" Click="btnPlus_Click" >
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="Transparent" CornerRadius="0,5,0,0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border"  Property="Background" Value="#E3E3E3"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="▴" FontSize="20" VerticalAlignment="Center" Margin="0,5,0,0"/>
                        </Button>
                        <Button x:Name="btnMinus" Height="20" Width="30" Click="btnMinus_Click" >
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="Transparent" CornerRadius="0,0,5,0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border"  Property="Background" Value="#E3E3E3"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="▾" FontSize="20" VerticalAlignment="Center" Margin="0,0,0,5"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <Button IsEnabled="False" x:Name="btnAddProduct" Style="{StaticResource AcceptButton}" Width="200" Height="45" Content="Пополнить" Click="btnAddProduct_Click" />
        </StackPanel>
    </Grid>
</Page>
