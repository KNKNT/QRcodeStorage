<Page x:Class="QRcodeStorage.Pages.CreateProduct"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QRcodeStorage.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1350"
      Title="CreateProduct">

    <Border Padding="30,0,30,0" Background="{StaticResource Background}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border Background="White" CornerRadius="15" Margin="0,20,0,20" ClipToBounds="True">
                <StackPanel VerticalAlignment="Center">
                    <RadioButton x:Name="rbCreateNewProduct" Height="70" Style="{StaticResource ModeButtonUp}" Checked="rbCreateNewProduct_Checked" />
                    <RadioButton Height="70" Style="{StaticResource ModeButtonDown}"  />
                </StackPanel>
            </Border>

            <Frame x:Name="NavigationFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>

        </Grid>
    </Border>
</Page>
