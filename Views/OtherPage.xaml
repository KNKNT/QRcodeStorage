<Page x:Class="QRcodeStorage.Views.OtherPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QRcodeStorage.Views"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="800"
      Title="OtherPage">
    <Border Padding="30,0,30,0" Background="{StaticResource Background}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Прочее" Foreground="{StaticResource Foreground}" FontSize="30" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="Управление CRUD операциями" FontSize="14" Foreground="{StaticResource PageForeground}"/>
            </StackPanel>

            <Grid Grid.Row="1"  HorizontalAlignment="Center" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Border Height="1" Background="LightGray" Margin="0,0,0,1" VerticalAlignment="Bottom"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Пользователи" Style="{StaticResource OtherRadioButton}" IsChecked="True"/>
                    <RadioButton Content="Роли" Style="{StaticResource OtherRadioButton}"/>
                    <RadioButton Content="Товары" Style="{StaticResource OtherRadioButton}"/>
                    <RadioButton Content="Категории" Style="{StaticResource OtherRadioButton}"/>
                    <RadioButton Content="Производители" Style="{StaticResource OtherRadioButton}"/>
                    <RadioButton Content="Движения" Style="{StaticResource OtherRadioButton}"/>
                    <RadioButton Content="Типы" Style="{StaticResource OtherRadioButton}"/>
                </StackPanel>

                <DataGrid Margin="0,15,0,0" Grid.Row="2" Style="{StaticResource MaterialDesignDataGrid}">
                    
                </DataGrid>
            </Grid>
        </Grid>
    </Border>
</Page>
